# Copy to .env for local API development (see also docs/env in repo root).

NODE_ENV=development
PORT=3001
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (subscription Checkout + Customer Portal + webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUBSCRIPTION_PRICE_ID=
DASHBOARD_URL=https://pulsefill.vercel.app
ENABLE_BILLING_ROUTES=true
ENABLE_STRIPE_WEBHOOK_ROUTES=true
# Optional free trial (days) passed into Checkout subscription_data
# STRIPE_TRIAL_PERIOD_DAYS=14

# Demo workspace seed (`pnpm seed:demo` — see docs/env)
# DEMO_STAFF_AUTH_USER_ID=<auth.users uuid for dashboard operator>
# DEMO_BUSINESS_ID=<optional existing business uuid>
# DEMO_SEED_ALLOW_PRODUCTION=true
# PULSEFILL_ALLOW_CUSTOMER_FLOW_SEED=1
