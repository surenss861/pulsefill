// Rename to PulseFillReleaseOverrides.xcconfig (see .gitignore) to override Release
// build settings without editing the committed PulseFillRelease.xcconfig.
//
// For TestFlight: from the `pulsefill` repo root run `bash scripts/archive-testflight.sh`
// to stamp `PULSEFILL_SOURCE_REVISION` + enable auth QA logs, then archive in Xcode.
//
// IMPORTANT: In .xcconfig, `//` starts a comment. Escape URLs like this:
//   https:/$()/$(/)your-host.example.com
//
// Example staging pilot:
// PULSEFILL_API_BASE_URL = https:/$()/$(/)your-staging.up.railway.app
// PULSEFILL_SUPABASE_URL = https:/$()/$(/)xxxx.supabase.co
// PULSEFILL_TIER = staging
// PULSEFILL_SUPABASE_ANON_KEY = your_publishable_or_anon_key
// PULSEFILL_SOURCE_REVISION = abc1234
// TestFlight QA: auth submit / validation os_log (no PII). Omit or NO for App Store.
// PULSEFILL_AUTH_QA_LOGS = YES
