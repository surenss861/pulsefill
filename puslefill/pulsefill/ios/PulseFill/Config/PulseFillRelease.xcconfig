// Release / Archive / TestFlight — baked into Info.plist via $(PULSEFILL_*).
// Optional overrides: copy PulseFillReleaseOverrides.xcconfig.example →
// PulseFillReleaseOverrides.xcconfig (gitignored) and set values; include runs last so it wins.
//
// IMPORTANT: In .xcconfig, `//` starts a comment. Use https:/$()/$(/)host so URLs are not truncated.
PULSEFILL_API_BASE_URL = https:/$()/$(/)pulsefill-production.up.railway.app
PULSEFILL_SUPABASE_URL = https:/$()/$(/)tlowrfeburobfgpaeins.supabase.co
PULSEFILL_TIER = production
// Optional: short git SHA for TestFlight QA (shown on auth + blocking diagnostics). Bump when cutting a build.
PULSEFILL_SOURCE_REVISION = 222ca3c
// Do not commit a real anon / publishable key here. For Archive / TestFlight, copy
// PulseFillReleaseOverrides.xcconfig.example → PulseFillReleaseOverrides.xcconfig (gitignored)
// and set PULSEFILL_SUPABASE_ANON_KEY there, or inject via CI secrets.
PULSEFILL_SUPABASE_ANON_KEY = YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
#include? "PulseFillReleaseOverrides.xcconfig"
